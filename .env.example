# Synthetic example: replace service names with your own existing services.
RUVIEW_URL=http://collector.example.invalid:3000
RUVIEW_API_TOKEN=
# Optional; leave empty to disable edge flags and server-module diagnostics.
RUVIEW_WS_URL=
RUVIEW_MODULES_URL=
RUVIEW_NODE_IDS=
# No location is trusted by default. See docs/configuration.md.
RUVIEW_NODE_PLACEMENTS={}
RUVIEW_MQTT_HOST=mqtt.example.invalid
MQTT_PORT=1883
MQTT_CLIENT_ID=ruview-home-bridge
MQTT_TOPIC_PREFIX=ruview/home
MQTT_DISCOVERY_PREFIX=homeassistant
MQTT_IDENTIFIER_PREFIX=ruview_home
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=false
# MQTT_CA_CERTS=/run/certs/ca.pem
# MQTT_CERTFILE=/run/certs/client.pem
# MQTT_KEYFILE=/run/certs/client.key
# MQTT_PASSWORD_FILE=/run/secrets/mqtt_password
# RUVIEW_API_TOKEN_FILE=/run/secrets/ruview_api_token
