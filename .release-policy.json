{
  "repository": "ha-homelab/ruview-home-assistant",
  "mode": "release",
  "default_branch": "main",
  "visibility": "public",
  "version_file": "version",
  "validation_workflows": [
    "tests.yml",
    "security.yml"
  ],
  "artifact_pattern": "release-assets*",
  "local_checks": [
    "uv run --frozen --extra dev sh scripts/check.sh"
  ],
  "notes": [
    "Examples and screenshots are synthetic. Site configuration, credentials, real observations and private Git history are excluded.",
    "Offline tests cover simulated boundaries. A beta release does not establish compatibility with every camera, network or Home Assistant installation."
  ],
  "release_notes": "CHANGELOG.md",
  "single_entry_ci": true,
  "versioning": {
    "schema": 1,
    "promotion": "promote-bytes",
    "files": [
      {
        "path": "version",
        "format": "text",
        "value": "package",
        "ecosystem": "pep440"
      },
      {
        "path": "pyproject.toml",
        "format": "toml",
        "field": "project.version",
        "value": "package",
        "ecosystem": "pep440"
      },
      {
        "path": "src/ruview_home_assistant/__init__.py",
        "format": "python",
        "field": "__version__",
        "value": "package",
        "ecosystem": "pep440"
      },
      {
        "path": "uv.lock",
        "format": "uv-lock",
        "package": "ruview-home-assistant",
        "value": "package",
        "ecosystem": "pep440"
      }
    ],
    "artifacts": [
      {
        "path": "ruview_home_assistant-*.whl",
        "format": "wheel",
        "package": "ruview-home-assistant",
        "value": "package",
        "ecosystem": "pep440"
      },
      {
        "path": "ruview_home_assistant-*.tar.gz",
        "format": "sdist",
        "package": "ruview-home-assistant",
        "value": "package",
        "ecosystem": "pep440"
      }
    ],
    "toolkit_revision": "f0bf0ec4921619f0de09ecd3eaa5e8673e4f9695"
  },
  "toolkit_revision": "f0bf0ec4921619f0de09ecd3eaa5e8673e4f9695",
  "sign_releases": true
}
