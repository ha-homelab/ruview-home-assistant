{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ha-homelab/ruview-home-assistant/schemas/node-attributes-v1.schema.json",
  "title": "node-attributes-v1",
  "type": "object",
  "required": [
    "schema",
    "node_id",
    "source",
    "calibration",
    "csi_age_ms",
    "inference_age_ms",
    "placement_valid"
  ],
  "properties": {
    "schema": {
      "const": "ruview.ha.node-attributes.v1"
    },
    "node_id": {
      "type": "integer",
      "minimum": 1,
      "maximum": 255
    },
    "placement_valid": {
      "type": "boolean"
    },
    "measurement_location": {
      "type": "string"
    },
    "configured_room": {
      "type": [
        "string",
        "null"
      ]
    },
    "room_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "room_coverage_validation": {
      "const": "unverified"
    },
    "source": {
      "const": "esp32"
    },
    "calibration": {
      "const": "unverified"
    },
    "classification_raw": {
      "enum": [
        "absent",
        "present_still",
        "present_moving",
        "active"
      ]
    },
    "confidence": {
      "type": [
        "number",
        "null"
      ]
    },
    "csi_age_ms": {
      "type": "number",
      "minimum": 0,
      "maximum": 10000
    },
    "inference_age_ms": {
      "type": "number",
      "minimum": 0,
      "maximum": 10000
    }
  }
}
