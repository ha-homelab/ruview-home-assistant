include version LICENSE README.md CHANGELOG.md SECURITY.md CONTRIBUTING.md THIRD_PARTY_NOTICES.md Dockerfile compose.yaml .env.example
include .gitignore .dockerignore
recursive-include docs *.md *.png *.html
recursive-include examples *.json *.jsonl
recursive-include schemas *.json
recursive-include tests *.py *.json
recursive-include scripts *.py *.sh

recursive-include LICENSES *.txt

include RELEASING.md .release-policy.json uv.lock
recursive-include .github *.py *.yml *.yaml *.txt

include GOVERNANCE.md CODE_OF_CONDUCT.md ROADMAP.md

# The source archive retains the complete reviewed release-client inputs.
recursive-include .github/cosign *
recursive-include .github/gh *.json LICENSE
recursive-include scripts *.go

recursive-include container *.txt
